{
  "name": "dinas-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p src/tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p src/tsconfig.json --noEmit",
    "typecheck:seed": "tsc -p src/tsconfig.seed.json --noEmit",
    "db:seed": "prisma db seed",
    "db:seed:reset": "prisma db seed -- --reset",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db seed -- --reset",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "ngrok": "^5.0.0-beta.2",
    "prisma": "^5.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  }
}
