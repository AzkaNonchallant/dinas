meta {
  name: Upload Document
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/travel/{{travelId}}/documents
  body: multipartFormData
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form-data {
  file:file(./files/contoh-nota.pdf)
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("docId", res.body.data.id);
  }
}

docs {
  multipart/form-data, field wajib: file. Maks 10MB.
  MIME: image/jpeg|png|webp, application/pdf.
  File contoh ada di bruno/files/contoh-nota.pdf.
}
