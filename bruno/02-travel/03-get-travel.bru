meta {
  name: Get Travel
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/travel/{{travelId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.status === 200 && res.body.data.approvals && res.body.data.approvals.length) {
    bru.setEnvVar("approvalId", res.body.data.approvals[0].id);
    console.log("approvalId level-1:", res.body.data.approvals[0].id);
  }
}
