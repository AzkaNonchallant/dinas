meta {
  name: Update Travel
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/travel/{{travelId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "destination": "Surabaya (updated)",
    "purpose": "Kunjungan klien & training tim sales",
    "startDate": "2026-10-01",
    "endDate": "2026-10-04",
    "estimatedCost": 5000000,
    "policyId": {{policyId}}
  }
}

docs {
  Hanya pemilik & status masih DRAFT (selain itu 400).
}
