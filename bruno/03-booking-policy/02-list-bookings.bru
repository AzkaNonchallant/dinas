meta {
  name: List Bookings
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/travel/{{travelId}}/bookings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.length) {
    bru.setEnvVar("bookingId", res.body.data[0].id);
  }
}
