meta {
  name: Applicable Policies
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/travel/policies/applicable?positionId={{positionId}}&destinationTier=DOMESTIC
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.length) {
    bru.setEnvVar("policyId", res.body.data[0].id);
  }
}

docs {
  Kedua query WAJIB. Dipakai form pengajuan untuk auto-fill policyId.
}
