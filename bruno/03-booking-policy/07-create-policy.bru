meta {
  name: Create Policy
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/travel/policies
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Policy Staf - Domestik",
    "positionId": {{positionId}},
    "destinationTier": "DOMESTIC",
    "hotelLimit": 800000,
    "transportLimit": 1500000,
    "allowanceLimit": 500000
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("policyId", res.body.data.id);
  }
}

docs {
  Role: SUPER_ADMIN. positionId boleh null = policy general.
}
