meta {
  name: Update Booking Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/travel/bookings/{{bookingId}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "CONFIRMED"
  }
}

docs {
  Role: TRAVEL_ADMIN, ADMIN. status: PENDING | CONFIRMED | CANCELLED
}
