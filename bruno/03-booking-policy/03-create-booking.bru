meta {
  name: Create Booking
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/travel/{{travelId}}/bookings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "HOTEL",
    "provider": "Aston Hotel",
    "bookingCode": "AST-12345",
    "description": "2 malam, include breakfast",
    "bookingDate": "2026-09-20",
    "amount": 1200000
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("bookingId", res.body.data.id);
  }
}

docs {
  Role: TRAVEL_ADMIN, ADMIN. Travel harus status APPROVED (400 kalau belum).
  type: TRANSPORT | HOTEL | OTHER
}
