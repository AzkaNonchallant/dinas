meta {
  name: Verify (Approve)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/reimbursements/{{reimbursementId}}/verify
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "approvedAmount": 4200000,
    "status": "APPROVED"
  }
}

docs {
  Role: FINANCE / SUPER_ADMIN. Hanya status SUBMITTED / IN_REVIEW.
  Server hitung differenceAmount = approvedAmount - advanceAmount.
  Field "note" belum didukung schema.
}
