meta {
  name: Get Reimbursement
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/reimbursements/{{reimbursementId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.items && res.body.data.items.length) {
    bru.setEnvVar("itemId", res.body.data.items[0].id);
  }
}
