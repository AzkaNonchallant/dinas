meta {
  name: Add Item
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/reimbursements/{{reimbursementId}}/items
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "category": "HOTEL",
    "description": "Hotel Aston Surabaya 2 malam",
    "amount": 1200000,
    "transactionDate": "2026-10-02",
    "receiptPath": "contoh-nota.pdf"
  }
}

script:post {
  if (res.status === 201 && res.body.data && res.body.data.items && res.body.data.items.length) {
    bru.setEnvVar("itemId", res.body.data.items[res.body.data.items.length - 1].id);
  }
}

docs {
  Hanya pemilik & status DRAFT. totalAmount otomatis di-recalculate.
  category: TRANSPORT | HOTEL | MEAL | ALLOWANCE | OTHER
  receiptPath = fileName hasil upload (endpoint upload nota belum ada).
}
