meta {
  name: Create Reimbursement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/reimbursements
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "travelId": {{travelId}},
    "advanceAmount": 1000000
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("reimbursementId", res.body.data.id);
  }
}

docs {
  CATATAN: src/modules/reimbursement/reimbursement.routes.ts masih kosong ->
  endpoint ini akan 404 sampai routes-nya didaftarkan.
  Syarat: pemilik travel & travel status COMPLETED (400 kalau belum), 1 reimbursement per travel (409).
}
