meta {
  name: Submit Reimbursement
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/reimbursements/{{reimbursementId}}/submit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  DRAFT -> SUBMITTED. 400 kalau totalAmount <= 0 (belum ada item).
  Notifikasi ke Finance belum diimplementasikan (TODO di service).
}
