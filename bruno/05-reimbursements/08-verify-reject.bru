meta {
  name: Verify (Reject)
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/reimbursements/{{reimbursementId}}/verify
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "approvedAmount": 3500000,
    "status": "REJECTED"
  }
}
