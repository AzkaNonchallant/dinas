meta {
  name: List Notifications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/notifications?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  isRead: false
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.data && res.body.data.data.length) {
    bru.setEnvVar("notificationId", res.body.data.data[0].id);
  }
}
