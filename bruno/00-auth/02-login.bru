meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.data.token);
    bru.setEnvVar("userId", res.body.data.user.id);
    console.log("Login sebagai:", res.body.data.user.role);
  }
}

docs {
  Login -> menyimpan token & userId ke environment.
  403 kalau akun dinonaktifkan (isActive=false).
}
