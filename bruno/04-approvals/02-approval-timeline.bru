meta {
  name: Approval Timeline
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/approvals/travel/{{travelId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Semua level approval untuk 1 travel request (urutan level).
  Akses: pemilik travel, approver, atau admin.
}
