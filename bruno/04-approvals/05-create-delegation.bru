meta {
  name: Create Delegation
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/approvals/delegations
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "delegateId": 5,
    "startDate": "2026-10-05",
    "endDate": "2026-10-10",
    "reason": "Cuti tahunan"
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("delegationId", res.body.data.id);
  }
}

docs {
  Role: MANAGER, DEPARTMENT_HEAD, HRD.
  400 kalau delegate tidak aktif,=self, atau overlap delegasi aktif lain.
  Ganti delegateId dengan userId akun lain.
}
