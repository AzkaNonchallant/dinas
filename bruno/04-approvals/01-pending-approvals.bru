meta {
  name: Pending Approvals
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/approvals/pending?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.data && res.body.data.data.length) {
    bru.setEnvVar("approvalId", res.body.data.data[0].id);
    console.log("approvalId:", res.body.data.data[0].id);
  }
}

docs {
  Role: MANAGER, DEPARTMENT_HEAD, HRD.
  Login pakai akun approver dulu (ganti email di environment) lalu run ini.
}
