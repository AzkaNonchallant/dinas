meta {
  name: Assign Role
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}/role
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role": "MANAGER"
  }
}

docs {
  Role: SUPER_ADMIN.
  Nilai: EMPLOYEE, MANAGER, DEPARTMENT_HEAD, HRD, FINANCE, TRAVEL_ADMIN, ADMIN, SUPER_ADMIN
}
