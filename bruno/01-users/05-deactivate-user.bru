meta {
  name: Deactivate User
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Role: SUPER_ADMIN. Soft delete -> isActive=false (user tidak dihapus fisik).
  Jangan dipakai userId milikmu sendiri.
}
