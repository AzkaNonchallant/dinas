meta {
  name: List Positions
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/users/positions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.length) {
    bru.setEnvVar("positionId", res.body.data[0].id);
  }
}
