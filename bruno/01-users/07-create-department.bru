meta {
  name: Create Department
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/users/departments
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Legal"
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("departmentId", res.body.data.id);
  }
}
