meta {
  name: Create Position
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/users/positions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Staf"
  }
}

script:post {
  if (res.status === 201) {
    bru.setEnvVar("positionId", res.body.data.id);
  }
}
