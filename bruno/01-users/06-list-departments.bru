meta {
  name: List Departments
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/users/departments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post {
  if (res.body && res.body.data && res.body.data.length) {
    bru.setEnvVar("departmentId", res.body.data[0].id);
  }
}
